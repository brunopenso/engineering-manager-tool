{
  "name": "@em-tool/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:migration:create": "tsx scripts/migration-create.ts",
    "db:migration:run": "tsx scripts/migration-run.ts",
    "db:migration:rollback": "tsx scripts/migration-rollback.ts",
    "db:seed": "tsx scripts/seed-run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.9.0",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7"
  }
}
