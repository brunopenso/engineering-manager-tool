{
  "name": "engineering-manager-tool",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run dev --parallel --stream",
    "build": "lerna run build",
    "test": "lerna run test --stream",
    "lint": "lerna run lint --parallel",
    "lint:fix": "lerna run lint --parallel --fix",
    "clean": "lerna run clean --parallel && rm -rf node_modules",
    "lerna:repair": "lerna repair",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lerna": "^9.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "26",
    "npm": "11"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "dependencies": {
    "tsx": "^4.22.3"
  }
}
